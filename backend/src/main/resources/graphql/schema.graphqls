type Query {
    getUserById(id: ID!): User
    getAllUsers: [User]
}

type Mutation {
    # VULNERABILITY: GraphQL login endpoint susceptible to batching attacks
    # Rate limiting can be bypassed by sending multiple login mutations in a single request
    login(username: String!, password: String!): AuthResponse
    createUser(username: String!, password: String!, email: String!): User
}

type User {
    id: ID!
    username: String!
    email: String!
    role: String
}

type AuthResponse {
    token: String!
    username: String!
}
